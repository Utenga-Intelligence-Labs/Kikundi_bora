# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kikundi_db
DB_SSLMODE=disable
# REQUIRED - min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-32-char-random-string-abc123
PORT=8080
# Public API base URL used for uploaded file links (avatars, docs)
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
ENVIRONMENT=development

# REQUIRED for seed - Admin account password (min 8 chars)
ADMIN_PASSWORD=

# Dev/manual testing only: set to 1 to bypass the failed-login rate limit
# ("Majaribio mengi mno ya kuingia"). NEVER enable in production.
# (Under `go test` the limit is bypassed automatically.)
# DISABLE_LOGIN_RATE_LIMIT=1
