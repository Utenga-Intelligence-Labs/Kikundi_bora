# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kikundi_db
DB_SSLMODE=disable
# JWT_SECRET is REQUIRED, min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-32-char-random-string-abc123
# Internal listen port (containers listen here; Docker maps host 5050 -> 8080)
PORT=8080
# Public API base URL used for uploaded file links (avatars, docs).
# Docker setup publishes the API on host port 5050.
PUBLIC_BASE_URL=http://localhost:5050
# Frontend origins allowed cross-origin. The Dockerized frontend is on 5051.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:5051
ENVIRONMENT=development

# REQUIRED for seed - Admin account password (min 8 chars)
ADMIN_PASSWORD=

# Dev/manual testing only: set to 1 to bypass the failed-login rate limit
# ("Majaribio mengi mno ya kuingia"). NEVER enable in production.
# (Under `go test` the limit is bypassed automatically.)
# DISABLE_LOGIN_RATE_LIMIT=1

# SMS channel (Part 1): provider name. "noop" (default) only logs messages.
# Real vendors: "sendafrica" (https://docs.sendafrica.online/ai-integration).
# SMS_PROVIDER=noop
# Credentials for a real vendor — secrets, never committed, never in the DB.
# For sendafrica: SMS_API_KEY is the X-API-Key (SA-...), SMS_SENDER_ID is an
# approved sender ID (omit = platform default SENDAFRICA), and SMS_BASE_URL
# can point at the sandbox instead of https://api.sendafrica.online.
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_BASE_URL=

# OTP verification (Part 2): off by default. The OTP model, service and
# /auth/verify-otp endpoint stay dormant until this is true.
# OTP_VERIFICATION_ENABLED=false
